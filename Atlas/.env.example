# ============================================================================
# Standalone Atlas - environment configuration template.
# Copy to `.env` and fill in. Never commit your real `.env`.
# ============================================================================

# Base URL of the Zoom Agentic AI REST API (where all HTTP clients point).
# The default matches a local Zoom Agentic AI dev instance.
ATLAS_API_BASE_URL=http://localhost:8000/api/v1

# Per-request timeout (seconds) for all outbound calls to Zoom Agentic AI.
ATLAS_API_TIMEOUT=30

# Optional bearer / API key forwarded to Zoom Agentic AI.
# Leave blank when the baseline has no auth enforced on /api/v1.
ATLAS_API_KEY=

# ---- HTTP client retry configuration ----
# Total number of retry attempts (on top of the initial attempt).
ATLAS_API_MAX_RETRIES=3

# Base backoff in seconds for exponential retry (2^n * backoff).
ATLAS_API_RETRY_BACKOFF_SECONDS=0.5

# HTTP status codes that trigger a retry (comma separated).
ATLAS_API_RETRY_STATUS_CODES=429,500,502,503,504

# ---- Standalone Atlas server ----
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8090
ATLAS_LOG_LEVEL=info
